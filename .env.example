DATABASE_URL=postgresql://ai_life:change-me@localhost:5432/ai_life
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=owner@example.com
PORT=5173
# Absolute HTTP(S) URL for the independently deployed trade-analysis dashboard.
TRADE_ANALYSIS_URL=
NODE_ENV=development
# Optional: random secret used to hash request IPs for analytics rate limiting.
ANALYTICS_IP_SALT=
# Set true only behind a reverse proxy you control that overwrites geo headers.
TRUST_PROXY=false
# Optional: comma-separated deployment or office IPv4 addresses/CIDRs to exclude before analytics is stored.
ANALYTICS_EXCLUDED_IPS=
HUAWEI_HEALTH_ENABLED=false
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
HUAWEI_REDIRECT_URI=https://ai-life.top/api/integrations/huawei/callback
HUAWEI_TOKEN_ENCRYPTION_KEY=
HUAWEI_HEALTH_API_BASE=https://health-api.cloud.huawei.com/healthkit/v2
HUAWEI_OAUTH_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
HUAWEI_SYNC_INTERVAL_HOURS=4
HUAWEI_SYNC_LOOKBACK_DAYS=3
HUAWEI_INITIAL_SYNC_DAYS=30
HUAWEI_HEALTH_SCOPES=
